# Google Glass XE-C: the DEBUG variant, a fragment merged after glass.config.
# SPDX-License-Identifier: GPL-2.0-only OR MIT
#
# Opt-in only: GLASS_VARIANT=debug scripts/build-kernel.sh builds it into
# build/kernel-$KV-debug. The default build does not change. Its device tree
# is dts/omap4-glass-xec-safe-debug.dts (the safe DT, with ramoops laid out
# so that the stock 3.4 kernel can read the log back).
#
# Phase 0: built and checked on the host only. Nothing here has run on a
# Glass. How it would be used is an inactive draft in
# docs/future-phases-draft.md.

# A kernel console over the micro-USB cable, with no extra hardware: the
# legacy serial gadget built in, with CDC ACM (g_serial's default use_acm=1),
# so /dev/ttyACM0 on the host. It binds as soon as the MUSB controller
# registers, without waiting for the initramfs, and the console replays the
# log from the start of boot. It takes the controller, so the initramfs's
# configfs gadget (NCM network) cannot bind in this variant: serial only.
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# Crash logs that survive a warm reset (ramoops; the region is in the DT).
# glass.config already has these; repeated so the variant stands alone.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# earlycon on UART3 (stdout-path in the DT). Nobody can read UART3 without
# opening the device (rule 7), but it costs nothing and the 8250 driver has
# the hook.
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK_TIME=y

# A stuck CPU or task prints a backtrace, which the pstore console keeps.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# The debug command line, appended to whatever the bootloader passes
# (CMDLINE_EXTEND), so it holds even if the boot.img line is lost or cut:
#   console=ttyGS0,115200  the USB console (the last console= is /dev/console)
#   earlycon               UART3, from the DT's stdout-path
#   ignore_loglevel        every message to every console
#   clk_ignore_unused, regulator_ignore_unused, pd_ignore_unused
#                          nothing the bootloader left on is switched off;
#                          they are hypothesis 1 of docs/reset-analysis.md
#   panic=10               reboot 10 s after a panic (glass.config agrees)
CONFIG_CMDLINE="console=ttyGS0,115200 earlycon ignore_loglevel clk_ignore_unused regulator_ignore_unused pd_ignore_unused panic=10"
CONFIG_CMDLINE_EXTEND=y
# CONFIG_CMDLINE_FROM_BOOTLOADER is not set
